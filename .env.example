# eve agent (raíz). Copia a .env.local con valores reales; nunca versionar .env*.

# Gemini API: ALTA PRIORIDAD. Si existe GEMINI_API_KEY, todo el agente
# (orquestador + subagentes) usa Gemini; sin ella cae a Muse (ver
# agent/lib/models.ts). Conseguir la key en aistudio.google.com con billing activo.
GEMINI_API_KEY=
# Opcional (default gemini-flash-latest): gemini-3-flash, gemini-3.1-flash-lite, ...
GEMINI_MODEL_ID=

# CRM (keys con scope; crm/.env.example documenta el resto)
CRM_API_URL=http://localhost:8787
CRM_FRONT_KEY=
CRM_OPS_KEY=
