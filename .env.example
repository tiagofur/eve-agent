# eve agent (raíz). Copia a .env.local con valores reales; nunca versionar .env*.

# Gemini API: ALTA PRIORIDAD. Si existe GEMINI_API_KEY, todo el agente
# (orquestador + subagentes) usa Gemini; sin ella cae a Muse (ver
# agent/lib/models.ts). Conseguir la key en aistudio.google.com con billing activo.
GEMINI_API_KEY=
# Opcional (default gemini-4-hydrogen): gemini-4-carbon, gemini-4-neon, ...
GEMINI_MODEL_ID=
# Modelos de contenido (defaults en crm marketing.ts / agent visual-config.ts)
NANO_BANANA_MODEL_ID=gemini-3-pro-image
OMNI_FLASH_MODEL_ID=gemini-omni-1.2-flash

# CRM (keys con scope; crm/.env.example documenta el resto)
CRM_API_URL=http://localhost:8787
CRM_FRONT_KEY=
CRM_OPS_KEY=

# Google Calendar + Gmail (creapolis.mx@gmail.com; generar refresh token con `node scripts/google-auth.mjs`)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
