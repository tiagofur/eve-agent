# Mission Control desktop — CRM connection (Vite bakes these at dev/build time).
# Copy to desktop/.env (git-ignored) and fill in real values.

# Local development: CRM API running on the host.
VITE_CRM_API_URL=http://localhost:8787
VITE_CRM_OWNER_KEY=<cp_owner_key>

# Production (online flow): the public URL fronted by nginx on the server,
# which proxies / to the CRM API (port 8787 is bound to 127.0.0.1 there).
# Prefer HTTPS: plain-HTTP targets can be blocked by the macOS webview.
# VITE_CRM_API_URL=https://<tu-dominio>
# VITE_CRM_OWNER_KEY=<cp_owner_key-produccion>

# Runtime overrides (no rebuild needed): the gear icon in the sidebar footer
# opens the Connection panel, which stores CREAPOLIS_API_URL and
# CREAPOLIS_OWNER_KEY in localStorage; they win over these build-time values.
