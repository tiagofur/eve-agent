DATABASE_URL=postgres://creapolis:creapolis@localhost:5433/creapolis
PORT=8787

# eve agent proxy credentials.
# Staff (Telegram daemon, desktop chat routes): authenticates as staff.
EVE_AGENT_URL=http://localhost:3200
EVE_CHANNEL_USER=
EVE_CHANNEL_PASSWORD=

# PUBLIC web chat proxy credential. Must be a DIFFERENT username from
# EVE_CHANNEL_USER: eve marks this principal as public and denies staff-only
# tools to it. When unset, the public chat answers 503 (fails closed).
EVE_PUBLIC_USER=
EVE_PUBLIC_PASSWORD=

# Cost guardrails for the public web chat.
# Max assistant turns per conversation thread, and global daily turn budget.
PUBLIC_CHAT_MAX_TURNS_PER_THREAD=60
PUBLIC_CHAT_DAILY_TURN_BUDGET=400

# Content packs: directory for marketing bundle ZIPs (relative to cwd or absolute).
# In production the compose file mounts a named volume here.
CONTENT_DIR=data/content-packs

# Public origin Instagram downloads pack slides from (the CRM's public HTTPS URL).
# PUBLIC_CONTENT_BASE_URL=https://crm.creapolis.dev

# Per-brand Instagram publishing (content packs 1-click). One set per brand;
# creapolis falls back to the legacy META_* variables when unset.
# PUBLISH_CREAPOLIS_IG_ACCOUNT_ID=
# PUBLISH_CREAPOLIS_ACCESS_TOKEN=
# PUBLISH_CREAPOLIS_FB_PAGE_ID=
# PUBLISH_PEPINILLO_IG_ACCOUNT_ID=
# PUBLISH_PEPINILLO_ACCESS_TOKEN=
# PUBLISH_SOLENNIX_IG_ACCOUNT_ID=
# PUBLISH_SOLENNIX_ACCESS_TOKEN=

# Rehearse the approve+publish flow without touching real Meta accounts.
# PUBLISH_DRY_RUN=true

# Gemini API (opcional): si existe, el agente y /api/marketing usan Gemini
# en vez de Meta (precedencia en agent/lib/models.ts). Sin creditos, omitir.
# GEMINI_API_KEY=
# Opcional: default gemini-flash-latest
# GEMINI_MODEL_ID=
