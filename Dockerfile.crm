FROM node:24-alpine AS base
WORKDIR /app

FROM base AS deps
COPY crm/package.json crm/package-lock.json* ./
RUN npm install


FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY agent/ /agent/
COPY crm/ ./

EXPOSE 8787
ENV PORT=8787
CMD ["npx", "tsx", "src/server.ts"]
